---
import Layout from "../../layouts/BasicLayout.astro";
import Card from "../../components/Card/index.astro";
import Patch from "../../components/Patch.astro";
import {NEXT_RACE, PATCHES} from "../../content/races";
import {METADATA, PAGE_HEADER} from "../../content/site";
import {GOALS, goalForSport, type Sport} from "../../lib/goal";
import {patchWall} from "../../lib/projection";
import {iconClass} from "../../lib/icons";

/*
 * THREE PRERENDERED PAGES, NOT ONE PAGE WITH A FILTER: `/patches`, `/patches/cycling`
 * and `/patches/running`.
 *
 * The filter has to survive with no client JavaScript, since this site ships none,
 * and it has to be linkable, because the whole point of a per-sport view is that a
 * goal card can send a reader straight to it. Three real URLs are the only shape
 * that gives both for free. The alternatives were considered and each loses one:
 *
 *   - Radio inputs plus `:has()` — zero JS, but the state lives in the DOM and no
 *     URL names it, so nothing can link to a filtered wall.
 *   - `#cycling` plus `:target` — linkable, but it is a filter drawn in CSS on a
 *     page whose markup still contains every bib, so the census, the title and what
 *     a crawler sees all describe the unfiltered page.
 *
 * A navigation also costs nothing to a reader here: the pages are prerendered, the
 * wall is small, and the back button does the obvious thing. (It said "six items" while
 * the calendar held one year; the wall keeps every race now, so a COUNT written here
 * rots every time a race is entered and nothing can see it — `docs-drift` resolves names
 * that must exist, never quoted values. Say the property, not the number.)
 *
 * THE REST PARAMETER MATCHES ZERO SEGMENTS, which is what makes `/patches` itself
 * one of the three rather than a fourth file repeating this one.
 */
export function getStaticPaths() {
    return [
        {params: {sport: undefined}, props: {sport: undefined}},
        ...GOALS.map((goal) => ({params: {sport: goal.sport}, props: {sport: goal.sport}})),
    ];
}

interface Props {
    sport?: Sport;
}

const {sport} = Astro.props;

const patches = patchWall(sport);
const goal = sport === undefined ? undefined : goalForSport(sport);

/*
 * THE CENSUS IS THE FILTER ROW'S LABEL, rather than a separate line of statistics.
 * A reader choosing between "all", "ride" and "run" wants to know what each one
 * costs them, and a count beside the word answers that in the place the question is
 * asked. It also keeps the page's only summary from being a decoration that has to
 * be maintained: these numbers cannot disagree with the wall, because they are the
 * lengths of the same arrays.
 */
const filters = [
    {href: "/patches", label: PATCHES.all_label, count: patchWall().length, active: sport === undefined},
    /*
     * THE CHIP SAYS THE SAME WORD THE CONTROL THAT OPENED THIS PAGE SAID. It used to read
     * `short_name` — "Ride" and "Run" — which is the bib's word, and the bib has a reason
     * for it that the filter row does not share: a 13rem bib line already carrying a date
     * and a status tag has no room for "CYCLING". This row has a whole line to itself.
     *
     * The cost of the short word was a vocabulary that broke at every click. A reader
     * presses "My cycling events" on the home page, lands on a page headed "My cycling
     * events" at a URL ending `/cycling`, and the control telling them which of the three
     * walls they are on says RIDE. That is the same defect the heading pairing above was
     * changed to close, in the one element whose whole job is to say where you are.
     */
    ...GOALS.map((g) => ({
        href: `/patches/${g.sport}`,
        label: g.goal_name,
        count: patchWall(g.sport).length,
        active: g.sport === sport,
    })),
];

/*
 * EACH PAGE NAMES ITSELF DIFFERENTLY, and that is not SEO housekeeping — the three
 * are one browser-tab strip apart and one back-button press apart, so a title
 * repeated three times is a real navigation cost. The heading and the title are
 * built from the same two strings for the same reason the goal cards' headings are:
 * a sport is called what the goal calls it, in one place.
 *
 * A SPORT PAGE IS HEADED WITH THE VERY STRING ITS CONTROL WEARS, not with a parallel
 * template, and that is what stops the two drifting. The goal card offers "My cycling
 * events" and this page answers to the same three words; the previous pairing said
 * "events" on the control and "Cycling patches" at the top, so the vocabulary broke at
 * the click. Reading NEXT_RACE.control here makes that break impossible rather than
 * merely corrected. (The all-sports page cannot use it — there is no sport to substitute —
 * so PATCHES.heading carries that one.)
 */
const sportWord = goal?.goal_name.toLowerCase() ?? "";

const heading = goal === undefined
    ? PATCHES.heading
    : NEXT_RACE.control.replace("{sport}", sportWord);

// NO YEAR IN THE TITLE. It read "My events · 2026", which was true while EVENTS held one
// year and became an overclaim the moment the wall started keeping every race — the same
// defect the lede's scope sentence had, in the string a tab strip and a search result
// show. The three titles are still distinct, which is all the suite asks: the sport is
// what separates them, and it always was.
const title = `${heading} — ${METADATA.name}`;

// ONE LEDE, THE SAME ON ALL THREE PAGES, and that is the point rather than a shortcut.
// It used to open with a sentence of scope that had to narrow per page; the heading and
// the filter row were already saying which page you are on, so the sentence was a second
// telling. What is left names the Finisher Patch, which is true of every one of these
// pages and of a wall with nothing on it. See the note on PATCHES.
const lede = PATCHES.lede;

// THE META DESCRIPTION STILL NARROWS, and it is not an oversight that this outlived the
// visible scope sentence: a crawler reads it alone, with no heading and no filter row
// beside it, so it is the one place the claim has nothing to lean on. It was a single
// unnarrowed string across all three routes once — the same overclaim the visible copy
// had already been fixed for, in the copy nobody looks at.
const description = goal === undefined
    ? PATCHES.description_all
    : PATCHES.description_sport.replace("{sport}", sportWord);
---

<Layout title={title} description={description}>
    <main class="text-[var(--text)] m-auto p-2 grid gap-2 max-w-4xl w-full sm:p-4 md:gap-3 md:p-6 lg:gap-4">
        <div class="flex flex-col gap-4">
            <p>
                {/* `min-h-6` is 1.5rem, which is the floor this codebase already set for a small
                     link: the Now card's explainer anchor is sized the same way and its comment
                     records why — 24px at the default text size is SC 2.5.8's AA minimum on the
                     nose, and a font-relative box grows with the reader's text instead of staying
                     put. Without it this link measures 60.25 x 20 and is the only control on the
                     site under that floor. Measured: it does not actually FAIL 2.5.8, because the
                     spacing exception applies at 143.82px to the nearest other target — so this is
                     the repo's own standard rather than the specification's. */}
                {/* `text-link` is the shared idiom, and this link takes it for the reason
                     EventsLink.astro takes it: the two are meant to be one object, mirrored —
                     one goes out to the wall and this one comes back. They were drawn alike by
                     hand in two places, in the same colour as the body text around them; now
                     they are drawn alike by construction. See uno.config.ts. */}
                <a
                        href="/"
                        class="text-link inline-flex items-center gap-2 min-h-6 text-sm"
                >
                    <span class={iconClass(PAGE_HEADER.home_icon)} aria-hidden="true"></span>{PAGE_HEADER.home_label}
                </a>
            </p>
            <div class="flex flex-col gap-2">
                {/* `break-anywhere` IS WHAT STOPS THE DOCUMENT SCROLLING SIDEWAYS UNDER TEXT ZOOM,
                     and the mechanism is not about this heading. Every text column on the home page
                     sits inside a card that clips, so a word too long for 320px is absorbed there;
                     this heading is the site's only un-clipped text column, so ITS minimum intrinsic
                     width sets the document's.

                     THE WORST WORD IS NO LONGER "patches" — the headings are "My events" and
                     "My {sport} events" now, so it is "running", and the page it bites on moved
                     with it. Re-measured at 320px with the class removed, as horizontal document
                     overflow: /patches/running carries 19px at a 48px root, 76px at 56 and 132px
                     at 64, while /patches and /patches/cycling are clean until 56. The previous
                     headings were worse at every one of those points (36px and 44px at a 48px
                     root), so the rename bought headroom here rather than spending it.

                     THE FAMILIAR UTILITY DOES NOT WORK HERE, which was measured after shipping it by
                     mistake. `overflow-wrap: break-word` breaks the rendered line but is defined
                     NOT to affect intrinsic minimum sizing, so the heading still demanded 311.8px
                     and the horizontal scroll was unchanged to the pixel. This class is
                     `overflow-wrap: anywhere`, which is the same break behaviour with the intrinsic
                     minimum included — the whole of what is needed. Do not "tidy" it back; the bib
                     name in Patch.astro uses the other value legitimately, because it sits in a grid
                     cell that already bounds it.

                     With `anywhere`: docOverflow 0 at 320px out to a 64px root, on all three
                     routes — two roots further than the previous headings reached. The 22px that
                     appears at a 72px root is NOT this heading and is unchanged by the rename:
                     identical on a build of the previous revision, so it is something else on the
                     page and predates all of this. Nothing changes at any ordinary size — neither
                     value breaks a word that has another way to fit. */}
                <h1 class="text-3xl font-bold m-0 break-anywhere">{heading}</h1>
                <p class="text-sm max-w-[60ch] m-0">{lede}</p>
            </div>
            <nav class="patch-filter" aria-label={PATCHES.filter_label}>
                {filters.map((f) => (
                        <a href={f.href} class="chip" aria-current={f.active ? "page" : undefined}>
                            {f.label}<span class="patch-filter-count">{f.count}</span>
                        </a>
                ))}
            </nav>
        </div>
        <Card>
            <ul class="patch-wall">
                {patches.map(({event, state}, index) => <Patch event={event} state={state} index={index}/>)}
            </ul>
        </Card>
    </main>
</Layout>

<style>
    /*
     * THE WALL IS A DENSITY, NOT A COLUMN COUNT. `auto-fill` with a 13rem floor lets
     * the browser decide how many bibs a row holds, which is the same argument the
     * control row makes in BasicLayout.astro: a hand-maintained count has to be
     * re-tuned every time either the box or the reader's text size moves, and it was
     * wrong twice here before it was deleted. `min(13rem, 100%)` is what stops the
     * floor exceeding the container on a narrow phone, where a fixed 13rem minimum
     * overflows instead of collapsing to one column.
     */
    .patch-wall {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr));
        gap: 0.5rem;
    }

    /*
     * THE FILTER ROW BORROWS THE WALL'S OWN TWO TREATMENTS: the page you are on is
     * drawn like a bib you have earned — inverted, solid — and the ones you are not
     * on are drawn like bibs you have not. It costs no new visual vocabulary and it
     * means the row and the wall cannot look like two unrelated components.
     *
     * `aria-current="page"` is what selects the solid state, so the styling reads
     * from the same attribute a screen reader does and the two cannot disagree. A
     * class would let them.
     *
     * The current page stays a LINK rather than becoming inert text. It is a real
     * destination, `aria-current` already says you are there, and removing it from
     * the tab order mid-row is a worse answer to "this one does nothing" than
     * letting it do the harmless thing.
     */
    .patch-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    /*
     * THE CHIP'S OWN DRAWING IS NO LONGER HERE. The box, the type, the resting hairline and
     * the shared hover, press and held press are `chip` in uno.config.ts, which is where a
     * kind of control on this site is written down — this row was the only wearer, spelled as
     * a descendant selector, so the site shipped a fourth kind of pressable thing that the
     * design system did not publish and the geometry gate could not see.
     *
     * WHAT IS LEFT BELOW IS EVERYTHING THIS ROW DOES THAT THE KIND DOES NOT: the current page
     * drawn like a bib you have earned, and the two states that have to answer to it. Their
     * order is measured and each carries its own argument — read them before touching one.
     * They out-specify the shortcut, so the cascade they were written against is intact and
     * the overlap with it is expected.
     */

    /*
     * Guarded because a touch browser applies `:hover` on tap and keeps it until the reader
     * taps elsewhere, which left whichever sport chip was last pressed wearing the accent
     * beside the one that is genuinely current. That is the worst place on the site for it:
     * the row's real state is `[aria-current="page"]` directly below, so a hover that stays
     * put fakes exactly the distinction this row exists to draw. Every `hover:` utility is
     * guarded by a variant in uno.config.ts; a hand-written rule carries its own, and
     * tests/build-output.test.ts fails the build on one that does not.
     */
    @media (hover: hover) {
        .patch-filter .chip:hover {
            border-color: var(--accent);
            color: var(--accent);
        }
    }

    /*
     * THE HELD PRESS, AND IT SITS ABOVE THE CURRENT-PAGE RULE WHERE ITS `:active` TWIN SITS
     * BELOW. The asymmetry is the whole point and it is measured, not stylistic.
     *
     * `[data-leaving]` is the press kept on screen until the page actually goes (the inline
     * script in BasicLayout.astro, and the shared idiom in uno.config.ts). Everywhere else on
     * the site the twin carries exactly what `:active` carries. Here it must not, because the
     * two states last for different lengths of time and one of these declarations is only
     * defensible while it is brief.
     *
     * Both rules repaint the label `var(--accent)`. On an ordinary chip that lands on the page
     * ground and is fine — 6.81:1 light, 13.22:1 dark. On the CURRENT chip the fill below is
     * `var(--text)`, and accent ink on that fill measures 2.77:1 light and 1.37:1 dark against
     * the 4.5:1 that 0.75rem/700 text asks for. The note under `:active` accepts that as the
     * price of a press being felt, and it is right to: a tap is ~100ms. Holding the same
     * declaration for a whole navigation — measured 376-788ms here, unbounded on a worse
     * connection — deletes the word that argument rests on.
     *
     * Specificity is equal either side — (0,2,1) as authored, (0,4,1) once Astro scopes both —
     * so ORDER is the
     * entire fix: above, the current chip keeps its readable inverted label at 18.86:1 light
     * and 18.09:1 dark, and every other chip still shows the held accent. Nothing is lost —
     * the chip you are already on is the one press that cannot be telling you a page is
     * coming.
     */
    .patch-filter .chip[data-leaving] {
        border-color: var(--accent);
        color: var(--accent);
        /* Snap, for the reason the shortcut's own press does: the base rule above transitions
           colour over 300ms, and an acknowledgement that fades in is not an acknowledgement of
           the thing that just happened. Gated in tests/build-output.test.ts, which found this
           rule ramping after it was written. */
        transition: none;
    }

    .patch-filter .chip[aria-current="page"] {
        background-color: var(--text);
        border-color: var(--text);
        color: var(--background);
    }

    /*
     * A PRESS SHOWS SOMETHING, ON EVERY CHIP INCLUDING THE CURRENT ONE.
     *
     * Debt created by guarding the hover above: the preflight turns the platform's own tap
     * flash off site-wide (`-webkit-tap-highlight-color: transparent` on `html, :host`), so
     * once the accent stopped firing on tap, a chip acknowledged a press with nothing at all.
     * `:active` is not hover-gated and does fire on touch, which is why the site's plated
     * controls already feel responsive on a phone and these did not.
     *
     * It sits AFTER the current-page rule deliberately, so the chip you are already on also
     * answers a press. That momentarily draws it like any other pressed chip, which is
     * correct — the press is feedback about the finger, not a claim about which page is open,
     * and `aria-current` continues to carry the real state throughout.
     */
    .patch-filter .chip:active {
        border-color: var(--accent);
        color: var(--accent);
        /* A tap is ~100ms against a 300ms colour transition, so without this the reader saw
           about a third of the accent — the press was drawn, faintly, and then undrawn. */
        transition: none;
    }

    /*
     * AND THE CHIP YOU ARE ALREADY ON KEEPS ITS LABEL, which is a debt the line directly above
     * created rather than an old one.
     *
     * `:active` sits below the current-page rule deliberately (see its note), so on the current
     * chip it repaints the label `var(--accent)` over the `var(--text)` fill — 2.77:1 light,
     * 1.37:1 dark, against the 4.5:1 that 0.75rem/700 text asks for. That was survivable while
     * the 300ms transition meant a ~100ms tap only travelled about a quarter of the way there;
     * snapping it takes the label the whole way, and in the dark theme it effectively erases it.
     * So the snap is what made an accepted approximation into a real one.
     *
     * The press is NOT given up here — the accent border still fires, which is what says the tap
     * landed. Only the glyphs keep the readable ink. Hoisting the whole `:active` above the
     * current-page rule was the other candidate and is worse: it also demotes the accent border,
     * leaving the current chip acknowledging a press with nothing, which is the exact debt the
     * note above was written to pay off.
     *
     * `transition: none` is not optional — the snap gate in tests/build-output.test.ts walks
     * every rule that carries a press and a `color`, and a bare colour here fails the deploy.
     */
    .patch-filter .chip[aria-current="page"]:active {
        color: var(--background);
        transition: none;
    }

    /* The count is quiet against its own label, whichever ground it lands on. */
    .patch-filter-count {
        opacity: 0.7;
    }

    /*
     * As on the bib: the selected state is carried by background-color, which a
     * forced-colours mode overrides. `Highlight`/`HighlightText` is the system pair
     * those modes use for exactly this — the one item in a set that is current.
     *
     * `forced-color-adjust: none` is here because a review panel reported that without
     * it the label renders INVISIBLE in the light forced palette: Chromium paints a
     * text backplate in Canvas behind text sitting on a forced background, and
     * `HighlightText` is also white there, so the glyphs would be white on white.
     *
     * BE HONEST ABOUT THE EVIDENCE — I COULD NOT REPRODUCE IT, and three attempts to
     * do so all failed their own calibration. `Emulation.setEmulatedMedia` makes
     * `(forced-colors: active)` match and makes the system colours resolve, but it does
     * not appear to reproduce Chromium's actual forced-colors PAINTING; with it on, the
     * rendering is identical whether this line is present or absent, and a probe that
     * deliberately sets the ink to the surface colour still reports the label visible.
     * A measurement of 1586 pixels of a single colour has been quoted for this and is
     * WITHDRAWN: the probe was sampling a rectangle the viewport resize had moved.
     *
     * The line stays anyway, and that is a deliberate call rather than deference: it is
     * the documented way to keep a colour pair you have chosen on purpose, it costs one
     * declaration, and the failure it guards against is a control whose label cannot be
     * read. Being wrong about the mechanism costs nothing here; being wrong about the
     * label costs a user the filter row.
     *
     * WHAT IS ACTUALLY OWED: a check in a real OS high-contrast mode, which is the only
     * thing that renders the backplate. Until then this block is precautionary.
     *
     * `border-color` is pinned to `CanvasText` for a reason that IS verifiable without
     * the backplate: opting out of forcing also stops the base rule's
     * `border-color: var(--text)` being overridden, so an author token would leak into
     * forced-colours mode. The pin keeps the border a system colour.
     */
    @media (forced-colors: active) {
        .patch-filter .chip[aria-current="page"] {
            forced-color-adjust: none;
            background-color: Highlight;
            border-color: CanvasText;
            color: HighlightText;
        }
    }

    /*
     * THE WAY BACK KEEPS ITS MARK IN FORCED COLOURS by the shared rule in BasicLayout.astro —
     * same mechanism as the filter pin above, presetIcons painting a glyph as a mask over
     * `background-color`, which the mode overrides. The link's own text and `.text-link`'s
     * underline both survive without help; what the shared rule restores is the mark.
     */
</style>
