---
import Card from "./Card/index.astro";
import {CAREER} from "../lib/constants";
import {iconClass} from "../lib/icons";
---

{CAREER.map((job) => (
<Card
        colSpan="md:col-span-1"
        rowSpan="md:row-span-6"
        title=`I'm a ${job.job_name}`
        titleIcon={iconClass(job.icon)}
>
    <div class="flex flex-col gap-2">
        <ul class="text-sm font-light list-disc list-inside">
            {job.description.map((item) => (
                    <li>{item}</li>))}
        </ul>
        <p class="text-xs font-light">
            {job.start_date} - {job.end_date}
        </p>
        <!-- THE COMPANY NAME IS A LINK, AND IT WAS THE ONLY ONE ON THIS SITE WITH NO SIGNIFIER
             AT ALL. It carried exactly `text-xs font-light` — the same two classes as the date
             line directly above it — so a reader saw two identical lines of which one navigated
             and the other did not, with no colour delta, no glyph and not even a hover.

             Nobody reported it, which is the point worth recording: the two affordance defects
             that WERE reported (the goal cards' control, the bib) at least had a glyph to
             notice. This one could only be found by reading the source, and it was found by
             auditing the class rather than by fixing the two instances that were named.

             `text-link` carries the whole treatment; see uno.config.ts. -->
        <a href={job.company_url} class="text-link text-xs font-light">
            {job.company}
        </a>
    </div>
</Card>
    ))}
