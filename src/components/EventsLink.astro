---
import {type Goal, NEXT_RACE} from "../lib/constants";
import {iconClass} from "../lib/icons";

interface Props {
    goal: Goal;
}

const {goal} = Astro.props;

/*
 * THE WAY OUT OF THE GOAL CARD, AND NOTHING ELSE.
 *
 * It replaces a bordered chip that was doing two jobs at once: reporting how long until
 * the next race AND being the link to the wall. Splitting them is what let each one get
 * smaller. The countdown is now an ordinary line of the card's figures column, not
 * interactive at all, and this is a quiet control that says where it goes — which is
 * also the only thing a control should say.
 *
 * IT IS THE SAME OBJECT AS THE WALL'S "Home" LINK, deliberately: an inline row, the
 * card's own text colour, a glyph, the accent on hover, and a 1.5rem floor. One goes out
 * and the other comes back, mirrored, so a reader who follows this lands on a page whose
 * way back is drawn the same way. That shared idiom is also why there is no box here —
 * this site's boxed control is the offset plate, which is its mark for a 48px styled
 * control, and wearing it on a 24px text link would either dilute the mark or claim a
 * size this is not.
 *
 * THAT IDIOM IS NOW A NAMED ONE, `text-link`, and it is what makes this element read as a
 * link at all. Two friends reviewing the site did not know this could be clicked, and the
 * measurement says why: at 1024x600 this control and the figure line directly above it were
 * both rgb(250,250,250) at 12px — a contrast ratio of 1.00:1 between a link and a sentence —
 * with a 13px chevron the only thing distinguishing them. Both were reading on a phone, where
 * the hover colour below cannot happen at all. See uno.config.ts for the shortcut's reasoning
 * and for the measured proof that the treatment moves no box, which is the only reason it fits
 * the four-row budget this card is already spending in full.
 *
 * THE LABEL IS THE WHOLE ACCESSIBLE NAME, and there is no sr-only completion any more.
 * The chip had one because the words it showed ("Next race in 8 weeks") named neither the
 * race nor the destination, so the announced name had to add them. These words name the
 * destination outright — and name it with the very string that page is headed with, see
 * [...sport].astro — so appending "— cycling patch wall" would announce two names for
 * one place. The race name went with it, and that is the honest form: it is not on
 * screen for anyone now, so it is announced to nobody. One click reaches it.
 *
 * SC 2.5.8 IS THE FLOOR, not the border. With the box gone the target is exactly the ink
 * plus the glyph, so the 1.5rem floor below is what keeps it to the 24px this repo holds
 * every small control to. Nothing interactive sits next to it — the line above is plain
 * text — so the spacing exception is not being leaned on.
 *
 * That floor is authored here rather than taken as a utility, and the reason is that it
 * is TESTED here: tests/rendered-html.test.ts reads every rule whose selector names this
 * class and refuses a length in device pixels. Spelled as a utility the rule would sit
 * under a selector that check never looks at, and the assertion would go on passing over
 * a control it could no longer see. The wall's Home link makes the opposite choice for
 * the opposite reason; the shape it produces is identical.
 */
const label = NEXT_RACE.control.replace("{sport}", goal.goal_name.toLowerCase());
---

<a
        class="events-link text-link inline-flex items-center"
        href={`/patches/${goal.sport}`}
>{label}<span class={`${iconClass(NEXT_RACE.icon)} events-link-go`} aria-hidden="true"></span></a>

<style>
    /* `flex: none` for the reason the bib's icon has it: a 1em-square mask box that is
       allowed to compress renders a deformed glyph, and this one sits after a text run
       that will happily take the space. `1.1em` because a chevron's drawn stroke occupies
       less of its box than a letter does of its em, so at 1em it reads a size small. The
       negative end margin pulls the glyph's own side bearing back off the text, so the
       pair reads as one phrase rather than a word and a mark. */
    /*
     * No height, only a floor, and it is font-relative: the card clips, so a pinned box
     * here would delete the label the moment the reader enlarges their text. 1.5rem is
     * 24px at the default size — SC 2.5.8's AA minimum on the nose.
     *
     * `align-self` IS NOT COSMETIC. This anchor is a flex ITEM of the card's figures
     * column, and a column stretches its items across the cross axis by default — so
     * without this the link's box is the full width of the card, 182px at 1024 for 115px
     * of ink, and 67px of empty card to the right of the words navigates when clicked.
     * `inline-flex` does not prevent that; the parent decides an item's cross size. The
     * chip this replaced avoided the same trap with `width: max-content`, which is the
     * other spelling of the fix.
     */
    .events-link {
        min-height: 1.5rem;
        align-self: start;
    }

    .events-link-go {
        flex: none;
        font-size: 1.1em;
        margin-inline-start: 0.1em;
        margin-inline-end: -0.15em;
    }

    /*
     * Forced colours discard the accent and the text token alike, so without this the
     * control is the same CanvasText as the two figures above it and the only thing
     * separating them is the chevron. `LinkText` is the colour the mode reserves for
     * exactly this, and it is a system colour rather than a token, so it is set here
     * instead of among the themes.
     */
    @media (forced-colors: active) {
        .events-link {
            color: LinkText;
        }

        /*
         * WITHOUT THIS THE CHEVRON DISAPPEARS IN FORCED COLOURS. That used to leave the control
         * identified by colour alone; it no longer does, because `text-link`'s decoration is not
         * a forced property and paints in whatever ink the mode picks. The rule stays anyway —
         * losing one of two cues is still a loss, and the glyph is what says "this goes
         * somewhere" as opposed to merely "this is a link".
         *
         * The mechanism is presetIcons': an icon class paints its artwork as a MASK over
         * `background-color: currentColor`, and `background-color` is one of the properties a
         * forced-colours mode overrides. The glyph therefore paints Canvas on Canvas and vanishes,
         * while the border that used to identify the old chip vanished with the chip. Measured on
         * the built page with the mode emulated: glyph `rgb(255,255,255)` on a card of
         * `rgb(255,255,255)` — a ratio of exactly 1. On origin/main the chip kept a 1px LinkText
         * box, so this is a REGRESSION introduced here rather than an inherited gap.
         *
         * `forced-color-adjust: none` opts the glyph out of the override; the explicit LinkText is
         * what it paints instead. Same technique as ProgressBar.astro's fill, which had it from the
         * start — it was applied to one of the two marks this branch ships and not the other.
         */
        .events-link-go {
            forced-color-adjust: none;
            background-color: LinkText;
        }
    }
</style>
