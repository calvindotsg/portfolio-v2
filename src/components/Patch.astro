---
import {goalForSport, NEW_TAB_NOTICE, PATCHES, type RaceEvent, raceKm, recordingKm, recordingsOf, stravaActivityUrl} from "../lib/constants";
import {formatPatchDate, patchDateSegments, type PatchState} from "../lib/projection";
import {iconClass} from "../lib/icons";

interface Props {
    event: RaceEvent;
    /** Derived from the calendar by `patchState`, never stored. See projection.ts. */
    state: PatchState;
    /**
     * This bib's position in the wall as rendered, from 0. It feeds `--i`, which the
     * entrance cascade in BasicLayout.astro turns into a delay.
     *
     * IT COMES FROM THE RENDER LOOP RATHER THAN FROM `nth-child`, and that is the
     * difference between a cascade that survives the calendar and one that has to be
     * extended by hand every time a race is entered. The home page's ladder is written
     * out rung by rung because its children are authored; a wall's are data.
     */
    index: number;
}

const {event, state, index} = Astro.props;

/*
 * ONE BIB. Three states, TWO treatments — and on two of the three the distance is the only
 * thing drawn large.
 *
 * The face is the whole of the visual difference: an earned patch has it, and a race you
 * have not earned one for does not, whether that is because it has not happened yet or
 * because it was abandoned. Those last two share a drawing on purpose — the outline means
 * "no patch here", which is true of both — and what tells them apart is text.
 *
 * The sport's icon and name come from the GOAL that owns the sport, never from a
 * lookup beside EVENTS — `goalForSport` in constants.ts has the argument, and the
 * short version is that uno.config.ts safelists icon classes by reading GOALS and
 * has no reason to read EVENTS. A second lookup ships a class UnoCSS never generated
 * a rule for, which renders as a mask box at zero size: correct markup, no icon,
 * nothing red.
 *
 * THE FRACTION IS SPLIT OUT so it can be set small. A race distance is measured to
 * two decimals and the hundredths are real — 140.49 is not 140 — but at the size
 * this number is drawn they would dominate the digits that carry the meaning. The
 * text content is unbroken either way, so a screen reader still hears "140.49".
 *
 * `toFixed(2)` IS WHAT MAKES THAT A COLUMN OF ONE KIND OF NUMBER, and the races on the
 * wall print in THREE different shapes without it: 22.45, 130.03 and 160.56
 * already carry two places, 158.10, 21.10 and 42.20 lose their trailing zero to `158.1`,
 * `21.1` and `42.2`, and 1022.00 loses the point entirely to `1022`. (An earlier revision
 * of this comment claimed all but the tour were already two-place — worth the correction
 * because it is the SINGLE-place ones that make the case: a lone bare integer reads as an
 * approximation, and a mix of one and two places reads as inconsistent precision. Which
 * races fall in which group moves with the data, so re-read the array rather than this
 * list.) The bibs do not form a column — each sits in its own grid
 * cell at its own width — so this is not about digit alignment; it is that every bib
 * should claim the same precision about its distance.
 *
 * THE STATE IS SAID IN WORDS AS WELL AS IN THE TREATMENT. The outline carries it
 * visually and the words carry it in text, which is not redundancy to be tidied
 * away — SC 1.4.1 does not accept a visual treatment as the only carrier of
 * information. A finished bib needs no words because it is the unmarked case, and the
 * wall's lede gives it its name — a Finisher Patch.
 *
 * THE TWO UNEARNED STATES PUT THOSE WORDS IN DIFFERENT PLACES, and that asymmetry is the
 * decision this component was redesigned around rather than an inconsistency in it.
 *
 *   BOOKED carries `booked_label` as a tag in the meta row. It is an annotation on a bib
 *   whose figures are all still true: the race IS that far, it IS on that date, and none of
 *   it has happened yet.
 *
 *   A DNF replaces the hero with `dnf_result`. Nothing is being annotated — the bib's central
 *   claim is wrong. A results sheet prints DNF in the column a finishing POSITION would have
 *   gone in, a status code that REPLACES a result, and that is the only vernacular available:
 *   neither Strava nor Garmin models a DNF at all, so there is no app pattern to borrow. Six
 *   candidates carrying it as a tag were drawn first and all lost the same way — the meta row
 *   wraps, so three letters land tucked in after the sport at a fraction of the hero's size.
 *   The QUIETEST thing on the bib would have been carrying the most important fact about it.
 *   In the hero slot the same three letters are the largest.
 *
 *   THE KILOMETRES IT DISPLACES NEED NO SPECIAL ROW ANY MORE, and that is what the ledger
 *   took off this branch. They used to move into a `Covered` line that existed to argue they
 *   were not a result; the ledger's `RECORDED` row already says exactly that, on every earned
 *   bib, because naming the source is what the whole device does. So a DNF bib and a finished
 *   one now differ in their HERO and in nothing else — one grid template serves both.
 *
 * THE VARIANT THAT PUT `DNF` ON THE EARNED FACE WAS DRAWN AND REJECTED. The inverted face is
 * the strongest mark this palette can make and it is spent on the thing the page is about;
 * an unfinished race is precisely not that. So the word goes in the hero and the face stays
 * withheld — see `.bib--dnf` in the sheet for what that costs, which is nothing.
 *
 * THE MIRROR-IMAGE TAG WAS CONSIDERED AND REJECTED when the earned bib was named,
 * which is the obvious next move and the wrong one. You mark the exception, not the
 * norm: EVENTS is the owner's whole racing history now, so the earned bib is the
 * MAJORITY of a full wall, and a label repeated on nine bibs in ten stops being
 * information. `booked_label` earns its place precisely because the outline is the
 * minority — the maintainer's call, taken with both options drawn.
 *
 * THE BIB IS NEVER THE ANCHOR NOW, AND THE FACT THAT KILLED THAT DESIGN IS A SECOND LINK.
 *
 * It used to be one wherever a race had exactly one recording: the whole 260px box was the
 * control, and its accessible name was the bib's entire text, which self-disambiguated
 * against every other bib on the wall. That was the right answer while Strava was the only
 * place a bib could go. A race with a published result has TWO destinations that are not the
 * same claim — the organiser's sheet and the rider's file — and anchors do not nest, so one
 * of them would have had to sit inside the other or not exist. The usual escape, a stretched
 * `::before` over the card, is unavailable here: patch-wall.test.ts refuses any rule reaching
 * a bib through a pseudo-element, by construction.
 *
 * SO EVERY DESTINATION IS A LINE ON THE STUB, and the rule the bib was already drawn by
 * simply took its second case: **a bib is the link when there is one place to go; when there
 * is more than one, the bib HOLDS the links.** Split races have worked that way since they
 * arrived; what changed is that a race can now have more than one place to go without being
 * split at all, which is common rather than exceptional. Keeping two idioms for the same
 * object — sometimes the box, sometimes the stub — would mean a reader has to work out which
 * kind of bib they are looking at before they know where to aim.
 *
 * THE OBJECTION THAT USED TO DECIDE THIS IS ANSWERED RATHER THAN OVERRULED. Delegating on
 * every bib was rejected once because it would give every linked bib the SAME accessible name
 * — one string, "View on Strava", repeated across as many races as the wall holds, which is
 * SC 2.4.4. That is exactly what `race_name` in constants.ts exists for: every stub link's
 * name now carries the race and its date, so the disambiguation the whole-bib form got for
 * free is stated instead of inherited. Verified on the rendered wall rather than argued —
 * patch-wall.test.ts holds every link name on a page distinct.
 *
 * WHAT IT COSTS IS REAL AND WAS ACCEPTED: a 260px target becomes a 24px row on races that
 * have nothing wrong with them. What buys it back is that the row says where it goes, which a
 * box never did — the two friends who could not tell a bib was clickable were looking at the
 * form that was easiest to hit.
 *
 * `container-type` stays on whichever element wears `.bib`, or the hero's `30cqi` loses its
 * container. Every selector involved is class-based — `.bib`, `.bib--booked`, `.bib-meta` —
 * as are `structuralSelector` and the colour model in patch-wall.test.ts, which is what made
 * this change an edit rather than a rewrite.
 *
 * THE STUB IS CONDITIONAL ON THERE BEING SOMEWHERE TO GO, NOT ON THE STATE. `recordings` is
 * optional and a finished race without one must still render as an ordinary finished bib —
 * the rule above `EVENTS` in constants.ts, and what makes filling in a back catalogue a data
 * edit. Whether any race on the wall is in that state right now is not the point and changes
 * with the data; the fixtures in patch-wall.test.ts hold the case either way.
 *
 * `target="_blank"` and NO `rel`, matching this site's existing convention — Now.astro and
 * IntroCard.astro both use a bare `target="_blank"` and browsers imply `noopener`.
 * Introducing `rel` on one link out of three is how a convention starts to look accidental.
 *
 * NO `aria-label`, ANYWHERE ON THIS BIB. Each stub link's name is the words on screen plus an
 * `sr-only` run that EXTENDS them — the race, its date, and for the results link which clock
 * its figure is. That is a true superset of what is on screen, this repo's rule; an aria-label
 * would REPLACE it with a summary. Read a name off the accessibility tree rather than
 * assembling it from this file: an earlier revision of this comment quoted one it had built by
 * hand and got the order wrong, and no assertion could see that (the guard uses `toContain`,
 * which is order-blind by construction).
 *
 * THE CALL TO ACTION IS THE LAST THING ON THE BIB, which is the position it should always have
 * had. It used to sit in the meta row as an `sr-only` transcription of a glyph, so a listener
 * heard the destination announced between the sport and the distance, before the race had even
 * been named. Now the words are visible, they sit under the perforation, and the announcement
 * follows the reading order the bib is drawn in.
 */
const date = patchDateSegments(event);
const goal = goalForSport(event.sport);
const [whole, fraction] = raceKm(event).toFixed(2).split(".");
const recordings = recordingsOf(event);
const dateText = formatPatchDate(event) ?? "";
/*
 * WHICH RACE THIS IS, for any stub link whose on-screen words are the same on every bib. See
 * `race_name` in constants.ts for why every one of them is owed it.
 */
const raceName = PATCHES.race_name.replace("{race}", event.name).replace("{date}", dateText);
/*
 * THE OFFICIAL ACCOUNT, READ ONCE. `net_time` wins where it exists — it is the rider's own
 * race, mat to mat — and the clock's NAME travels with the figure so the link can say which
 * one it is. The two are derived together on purpose: reading the time in one place and the
 * word in another is how a bib ends up announcing a gun time as a net one.
 */
const official = event.official;
const officialTime = official?.net_time ?? official?.gun_time;
const officialClock = official?.net_time === undefined ? PATCHES.gun_clock : PATCHES.net_clock;
/*
 * THE LEDGER, BUILT AS ROWS RATHER THAN AS BRANCHES IN THE MARKUP. Each row is one source's
 * own distance beside that same source's own clock, which is the rule the whole device rests
 * on: nothing a reader can divide crosses two accounts.
 *
 * A BOOKED BIB HAS NO LEDGER AT ALL. There is nothing to report yet — its hero already prints
 * the advertised distance, and a one-row ledger saying `OFFICIAL 21.10` under it would be the
 * same fact twice.
 *
 * A CELL CAN BE EMPTY AND THE ROW STILL EARNS ITS PLACE, which is the case the type reaches
 * and the calendar does not currently hold. A race remembered with a finishing time and no
 * recording has a clock and no honest distance: `raceKm` would fall back to the ADVERTISED
 * figure, and printing that against `RECORDED` would have the bib claim he covered a course
 * the site has no evidence he rode — on an abandoned race, the exact claim the hero is
 * refusing two rows up. So the distance cell is conditional on there being metres, and the
 * clock cell on there being a time, independently.
 */
const ledger: {who: string, km: string, time: string}[] = [];
if (state !== "booked") {
    if (official !== undefined && event.advertised_km !== undefined) {
        ledger.push({who: PATCHES.official_row, km: event.advertised_km.toFixed(2), time: officialTime ?? ""});
    }
    if (recordings.length > 0 || event.elapsed_time !== undefined) {
        ledger.push({
            who: PATCHES.recorded_row,
            km: recordings.length > 0 ? raceKm(event).toFixed(2) : "",
            time: event.elapsed_time ?? "",
        });
    }
}
/*
 * THE STUB'S LINES, IN THE ORDER A STRANGER CAN USE THEM. The results sheet first: it renders
 * for a logged-out visitor where every Strava link on this wall is a login wall.
 *
 * A ONE-RECORDING RACE GETS ONE LINE SAYING WHERE IT GOES; a race recorded in parts gets one
 * line PER PART, each printing that part's own distance and clock, so no link promises the
 * bib's summed hero. `time` is what separates the two forms and is absent on the others: a
 * shared label repeated once per part is information at two and noise at four, so the parts
 * carry figures instead — the argument `booked_label` is already decided by.
 */
const stub: {href: string, icon: string, label: string, time?: string, name: string}[] = [];
if (official?.url !== undefined) {
    stub.push({
        href: official.url,
        icon: PATCHES.official_icon,
        label: PATCHES.official_link,
        // A sheet can publish a result with no time on it — see `OfficialResult`. The clock
        // phrase then has nothing to name, so the link falls back to the plain race name
        // rather than announcing "net time , …".
        name: officialTime === undefined ? raceName : PATCHES.official_name
            .replace("{clock}", officialClock).replace("{time}", officialTime)
            .replace("{race}", event.name).replace("{date}", dateText),
    });
}
if (recordings.length === 1) {
    stub.push({href: stravaActivityUrl(recordings[0]), icon: PATCHES.strava_icon, label: PATCHES.strava_name, name: raceName});
} else {
    for (const part of recordings) {
        stub.push({
            href: stravaActivityUrl(part),
            icon: PATCHES.strava_icon,
            label: PATCHES.split_line.replace("{distance}", `${recordingKm(part).toFixed(2)} ${goal.measurable_unit}`),
            time: part.elapsed_time,
            name: PATCHES.split_name.replace("{race}", event.name).replace("{date}", dateText),
        });
    }
}
---

<li class="bib-cell" style={`--i:${index}`}>
{/* A `div`, always. The LIST ITEM is the cell wrapper above; a second one nested inside it
    is invalid HTML that no test in this repo reads markup strictly enough to see, and it
    was caught by looking at the built page. */}
<div
        class:list={["bib", `bib--${event.sport}`, state === "booked" && "bib--booked",
                     state === "dnf" && "bib--dnf", stub.length > 0 && "bib--stub"]}
>
    <p class="bib-meta">
        {/* One <time> per endpoint, never one around the whole range: `datetime` names a
            single instant, so a tour wrapped in one would tell a machine that nine days
            of riding happened on the 7th. The dash carries no date and is plain text. */}
        {date && (
                <span class="bib-date">
                    {date.map((seg) => seg.iso ? <time datetime={seg.iso}>{seg.text}</time> : seg.text)}
                </span>
        )}
        <span class="bib-sport">
            <span class={`${iconClass(goal.goal_logo)} bib-icon`} aria-hidden="true"></span>
            <span class="bib-word">{goal.short_name}</span>
        </span>
        {state === "booked" && <span class="bib-tag">{PATCHES.booked_label}</span>}
    </p>
    {/* THE HERO SLOT SAYS HOW THE RACE ENDED, AND ON ONE KIND OF BIB THAT IS NOT A DISTANCE.
        See the note at the head of this file for the whole argument; what it comes to here is that a
        results sheet prints DNF in the column a finishing POSITION would have gone in — a
        status code REPLACING a result rather than annotating one — so it takes the slot, and
        the kilometres move down to a row that says what they are.

        NO UNIT ON THAT BRANCH. `.bib-unit` sets "KM" on its side against the number, and a
        unit is a thing you put on a QUANTITY; beside three letters it would be reading as a
        unit of DNF. The ledger below states the unit once, in a column heading, which is what
        lets this branch drop it without the bib losing the word entirely.

        THE EXPANSION IS SR-ONLY AND SITS OUTSIDE `.bib-value`, which is deliberate rather
        than fussy: inside it, the hero's text content becomes "DNFDid not finish" and every
        assertion that reads that element — and every future one — has to know about it. */}
    {state === "dnf" ? (
            <Fragment>
                <p class="bib-value">{PATCHES.dnf_result}</p>
                <span class="sr-only">{PATCHES.dnf_name}</span>
            </Fragment>
    ) : (
            <Fragment>
                <p class="bib-value">{whole}<span class="bib-fraction">.{fraction}</span></p>
                <p class="bib-unit">{goal.measurable_unit}</p>
            </Fragment>
    )}
    <p class="bib-name">{event.name}</p>
    <p class="bib-place">{event.country}</p>
    {/* THE LEDGER: WHOSE ACCOUNT, HOW FAR, HOW LONG — once per source that has one.

        THE HEADING STATES THE UNIT ONCE. Repeating it on every figure was built first and
        does not fit; the measurements are in `time_head` in constants.ts. The distance
        heading is the goal's own `measurable_unit`, the same string the hero sets on its
        side, so the two cannot word it differently.

        THE FIRST CELL OF THE HEADING ROW IS EMPTY, and it is a real element rather than a
        skipped one: `display: contents` puts these three spans directly into the ledger's
        grid, so leaving it out would shift the two headings a column to the left. It carries
        no text, so it announces as nothing.

        A CELL'S CLASS NAMES ITS COLUMN, NOT ITS KIND, and that is what keeps a heading over
        the figures it governs. All three captions — the two headings and each row's source
        name — are drawn alike, because they ARE alike; what differs is that a heading is
        ALIGNED with the column under it, and alignment is the property that has to win. The
        shared rules below are written as selector lists so a heading and its column cannot
        drift apart. */}
    {ledger.length > 0 && (
            <div class="bib-ledger">
                <div class="bib-ledger-head">
                    <span></span>
                    <span class="bib-ledger-km-head">{goal.measurable_unit}</span>
                    <span class="bib-ledger-time-head">{PATCHES.time_head}</span>
                </div>
                {ledger.map((row) => (
                        <div class="bib-ledger-row">
                            <span class="bib-ledger-who">{row.who}</span>
                            <span class="bib-ledger-km">{row.km}</span>
                            <span class="bib-ledger-time">{row.time}</span>
                        </div>
                ))}
            </div>
    )}
    {/* THE STUB. One line per place this bib can go, each its own link, under one perforation.

        THE RESULTS SHEET IS FIRST because it is the one a logged-out reader can follow — see
        `official_link` in constants.ts. Where a race was recorded in parts, each part prints
        its own distance and clock, so the bib's summed hero is never what any link promises.

        The race and the date are said in the accessible name rather than on the bib — this
        bib's rule is that the name is a true superset of what is on screen, never an
        aria-label replacing it, and a reader listing every link on the page needs both.

        (The obvious phrasing of what NEW_TAB_NOTICE says is not written here on purpose: that
        word is a UnoCSS utility, and prose in an `.astro` file is extracted like markup, so
        naming it emits a rule no element wears and the orphan gate fails the build.) */}
    {stub.length > 0 && (
            <ul class="bib-stub">
                {stub.map((line) => (
                        <li>
                            <a class="bib-stub-link" href={line.href} target="_blank">
                                <span class={`${iconClass(line.icon)} bib-icon bib-stub-mark`} aria-hidden="true"></span>
                                <span class="bib-stub-label">{line.label}</span>
                                {line.time && <Fragment>{" "}<span class="bib-stub-time">{line.time}</span></Fragment>}
                                <span class="sr-only">{", " + line.name + " "}</span>
                                <span class="sr-only">{NEW_TAB_NOTICE}</span>
                            </a>
                        </li>
                ))}
            </ul>
    )}
</div>
</li>

<style>
    /*
     * THE GRID ITEM IS THE CELL, THE BIB IS INSIDE IT. One wrapper, for one reason: where
     * a race has a verified activity the bib itself is an anchor, and an anchor cannot be
     * a child of `.patch-wall` — that is a list and its children are list items.
     *
     * `display: grid` here rather than nothing, so the bib fills a cell the wall's row has
     * stretched. Without it a bib in a row with a taller neighbour sits at its own height
     * and the row goes ragged, which is a defect the previous single-element structure got
     * for free and this one has to ask for.
     *
     * The cell carries no treatment of its own. Every class-based selector this file and
     * tests/patch-wall.test.ts use still lands on `.bib`, so the structure changed and the
     * colour model did not.
     */
    .bib-cell {
        display: grid;
    }

    /*
     * THE BIB'S OWN BOX. Four locals do all the work of the two treatments, so a
     * treatment is a set of values rather than a second copy of the layout:
     *
     *   --face   the bib's background
     *   --hole   the pin holes punched out of it
     *   --ink    everything printed on it
     *   --sport  the sport mark, which is the one thing that is not --ink
     *
     * A FINISHED BIB IS INVERTED — face --text, ink --background — which is the
     * strongest mark this palette can make and is spent here deliberately: an earned
     * bib is the thing the page is about. A booked bib is the same box with the face
     * removed, and differs in nothing but these values and the border — which is why the
     * two cannot drift apart in layout.
     *
     * A DNF IS AGAIN NOTHING BUT A SET OF VALUES, and the round trip is worth recording. It
     * used to re-declare `grid-template-areas` as well, because its hero is a word rather
     * than a number and the distance it displaced needed a row of its own — which forced a
     * FOURTH template for the case that also had a stub, since grid areas do not merge and
     * two single-class rules would simply have deleted each other's row. The ledger holds
     * every account in one area on every earned bib, so the displaced distance has nowhere
     * special to go and the two extra templates went with it. The sentence above is true of
     * the LAYOUT again, not only of the face.
     */
    .bib {
        --face: var(--text);
        --hole: var(--card-background);
        --ink: var(--background);
        /* Finished: the mark sits on the inverted face, so it takes the ink-side hue.
           `--sport-on-ink` is set by the per-sport rule below, on this same element —
           a custom property resolves against the element's own computed value, so the
           order these two rules appear in cannot matter. */
        --sport: var(--sport-on-ink);
        container-type: inline-size;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas: "date date" "value unit" "name name" "place place" "ledger ledger";
        align-content: start;
        row-gap: 0.3rem;
        padding: 0.7rem 0.8rem 0.65rem;
        border: 1px solid transparent;
        border-radius: 2px;
        color: var(--ink);
        background-color: var(--face);
        /*
         * FOUR PIN HOLES FOR A RUN, TWO FOR A RIDE, and the count is the information.
         * A running bib is pinned at four corners; a ride's frame number is zip-tied
         * at two. It reads as a detail and it is a second, non-colour channel for the
         * sport — the icon and the word being the first two.
         *
         * Drawn as radial gradients rather than as pseudo-elements because there are
         * up to four of them and one background-image is one declaration. 1.7px solid
         * to 1.8px transparent is the antialiasing band; a hard stop renders a stepped
         * circle at this size.
         */
        background-image:
            radial-gradient(circle at 7px 7px, var(--hole) 0 1.7px, transparent 1.8px),
            radial-gradient(circle at calc(100% - 7px) 7px, var(--hole) 0 1.7px, transparent 1.8px),
            radial-gradient(circle at 7px calc(100% - 7px), var(--hole) 0 1.7px, transparent 1.8px),
            radial-gradient(circle at calc(100% - 7px) calc(100% - 7px), var(--hole) 0 1.7px, transparent 1.8px);
    }

    .bib--cycling {
        --sport-on-card: var(--sport-ride);
        --sport-on-ink: var(--sport-ride-on-ink);
        background-image:
            radial-gradient(circle at 7px 7px, var(--hole) 0 1.7px, transparent 1.8px),
            radial-gradient(circle at calc(100% - 7px) 7px, var(--hole) 0 1.7px, transparent 1.8px);
    }

    .bib--running {
        --sport-on-card: var(--sport-run);
        --sport-on-ink: var(--sport-run-on-ink);
    }

    /*
     * BOOKED: A BIB YOU HAVE NOT EARNED YET. No face — so no holes either, because a
     * hole is punched out of something — and normal-polarity ink on the card.
     *
     * The holes are removed explicitly rather than left to disappear on their own.
     * They would: --hole is --card-background and the face is transparent, so they
     * paint card-on-card and vanish. Note the hazard that is NOT the reason — an
     * earlier revision of this comment claimed re-toning --card-background would put
     * grey dots on a booked bib, and it cannot: the hole and the surface behind the
     * bib are the SAME token, so they re-tone together. The real reason is that the
     * coincidence holds only while a bib sits on a card. Put one on any other surface
     * — the page background, a tinted panel — and four dots appear on a bib that is
     * meant to have none, with nothing in the source saying they were ever drawn.
     *
     * The mark now sits on the CARD, so it takes the card-side hue. This is the swap
     * the token names in BasicLayout.astro exist to make legible; getting it backwards
     * is how a mark ends up at 2.77:1 with every structural assertion still green.
     */
    .bib--booked {
        --face: transparent;
        --ink: var(--text);
        --sport: var(--sport-on-card);
        border-color: color-mix(in srgb, var(--text) 32%, transparent);
        background-image: none;
    }

    /*
     * DNF: A BIB YOU WILL NEVER EARN. The face is withheld for the same reason a booked
     * bib's is — the inverted face is what an earned patch looks like and this is not one —
     * and the four values below are IDENTICAL to `.bib--booked`'s, character for character.
     *
     * THAT IDENTITY IS THE DESIGN, NOT A SHORTCUT, and it is what a third face would have
     * cost. A mid-tone "ghosted" ground was drawn and rejected: it needs its own token in
     * both themes, its own `--sport-on-*` pair so the mark stays legible on it, and four more
     * contrast pairs held forever by tests/patch-wall.test.ts — for a distinction the bib
     * already draws in words. Repeating a value is cheap; a new ground is not.
     *
     * SO WHAT SEPARATES THE TWO OUTLINES IS TEXT, AND DELIBERATELY ONLY TEXT. A booked bib
     * wears `booked_label` in the meta row; this one prints `dnf_result` in the hero slot the
     * distance would have had. That choice is what makes this state cost ZERO mode overrides
     * below: a hatch or a perforation is `background-image`, which print discards; a heavier
     * border or a knockout chip is colour, which forced colours replaces. Text is the one
     * channel no rendering mode takes away, so the state survives every mode without a second
     * drawing of it being argued and measured. The two `border-width` lists further down are
     * joined rather than added to — a DNF is an outline and prints like one.
     *
     * IT DECLARES NO TEMPLATE OF ITS OWN, AND THAT IS LOAD-BEARING RATHER THAN TIDY. The base
     * template's second column is `auto` and the ONLY thing that ever sits in it is
     * `.bib-unit`, which this branch does not render (see the markup, and the note there for
     * why a unit beside three letters would be reading as a unit of DNF). An `auto` track with
     * no item in it resolves to zero, and nothing declares a `column-gap` — so `"value unit"`
     * lays out identically to the `"value value"` this rule used to restate. Re-declaring it
     * would be a second copy of the base layout that has to be edited in step with it, which
     * is the drift the four locals above exist to prevent.
     */
    .bib--dnf {
        --face: transparent;
        --ink: var(--text);
        --sport: var(--sport-on-card);
        border-color: color-mix(in srgb, var(--text) 32%, transparent);
        background-image: none;
    }

    /*
     * FORCED COLOURS FLATTEN THE TWO TREATMENTS INTO ONE. The whole distinction is
     * carried by background-color and border-color, and a forced-colours mode
     * overrides both — a finished bib loses its face, a booked bib's hairline becomes
     * the same CanvasText as everything else, and every bib on the wall flattens to
     * the same box. The tag still says "Booked", so no information is lost, but the shape
     * stops helping.
     *
     * A thicker border on the earned bib restores the distinction in the one channel
     * that survives: border-style and border-width are not overridden. This is a
     * different mark from the one sighted readers get, which is the correct trade —
     * matching the inverted face is impossible here, and a distinction is worth more
     * than a faithful one that cannot be drawn.
     */
    @media (forced-colors: active) {
        .bib {
            border-color: CanvasText;
            border-width: 3px;
        }

        .bib--booked,
        .bib--dnf {
            border-width: 1px;
        }
    }

    /*
     * PRINT IS THE SAME PROBLEM AS FORCED COLOURS, so it gets the same answer.
     *
     * A finished bib is legible on screen because its ink is `--background` on a
     * `--text` face. Print drops the face — Chrome's default `print-color-adjust:
     * economy` discards backgrounds and keeps the ink — and what is left is the pale
     * half of the palette on white paper. A review of the wall measured the printed
     * result at 2.43:1, under the 4.5:1 floor, and in the dark theme that ink is
     * #FAFAFA, which is nothing at all.
     *
     * So every bib prints as an outline and the earned one keeps its distinction in the
     * channel that survives, which is exactly the trade the forced-colours rules above
     * makes. LITERAL BLACK RATHER THAN A TOKEN is deliberate: paper is white whichever
     * theme the reader had on screen, so every token here carries an assumption that is
     * only true half the time. The sport mark goes black with the rest — its hue is one
     * of three channels naming the sport and the icon and the word are the other two,
     * both of which print.
     */
    @media print {
        .bib {
            --face: transparent;
            --hole: transparent;
            --ink: #000;
            --sport: #000;
            border-color: #000;
            border-width: 2px;
            background-image: none;
        }

        .bib--booked,
        .bib--dnf {
            border-width: 1px;
        }
    }

    .bib-meta {
        grid-area: date;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45em;
        margin: 0;
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    /*
     * THE DATE AND THE TAG ARE DIMMED; THE SPORT MARK IS NOT. That split is the whole
     * reason these are three elements rather than one row with an opacity on it.
     *
     * The row carried `opacity: .8` as a unit in the design rig, and an ancestor
     * opacity composites everything under it — including a sport colour that was
     * chosen against the face it is now no longer quite sitting on. Measured on the
     * rendered pixel, that alone took the finished ride mark from #F3A3AA to
     * rgb(196,132,138), 9.96:1 down to 6.57:1, on a bib where nothing was supposed to
     * be dimmed at all. getComputedStyle cannot see it: it reports the authored
     * colour, which ancestor opacity does not touch.
     *
     * So the dimming is scoped to the two things that are meant to be quiet, and the
     * mark keeps the hue it was measured as.
     */
    .bib-date,
    .bib-tag,
    .bib-ledger-who,
    .bib-ledger-km-head,
    .bib-ledger-time-head {
        opacity: 0.8;
    }

    /*
     * THE THIRD UNBREAKABLE TOKEN ON A BIB, AND IT WAS MISSED TWICE. `.bib-place` and the row
     * `.bib-ledger` replaced were each given this after escaping the bib; "Booked" is the same
     * shape — one word with nowhere to break — and nothing had measured it.
     *
     * Found on a sweep of ORIGIN/MAIN taken as the baseline for this change, so it predates
     * everything here: measured against the bib's border box at 320px wide, the tag escapes by
     * 31.45px at a 44px root and 63.11px at 48. Outside the WCAG 1.4.4 bracket (which tops out
     * at 32) and therefore not a conformance failure, which is presumably why two passes over
     * this file walked past it — but the ink lands on the card at 1.045:1, so the word carrying
     * a bib's STATE is unreadable there, and that state has no other text carrier.
     *
     * tests/patch-wall.test.ts now holds all four rows to this rule rather than the two that
     * had already failed, which is the difference between a gate on a class and a gate on the
     * instances someone happened to notice.
     */
    .bib-tag {
        overflow-wrap: anywhere;
    }

    .bib-sport {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        color: var(--sport);
    }

    /* Not shrink-0 as a utility: this is scoped CSS and the icon is a flex item whose
       artwork is 1em square. Letting it compress deforms the glyph, which is a defect
       this project has already shipped once.
       Its own class rather than `.bib-sport > span:first-child`, for two reasons: the
       positional selector silently moves to the word if anything is ever inserted
       before the icon, and a combinator here is unrepresentable in the class-subset
       colour model that tests/patch-wall.test.ts uses — which now refuses such rules
       rather than mis-reading them. */
    .bib-icon {
        flex: none;
    }

    .bib-word {
        font-weight: 800;
    }

    /*
     * THE DISTANCE IS THE HERO, and it is sized against the BIB rather than against
     * the viewport: `30cqi` reads the bib's own inline size, so what the number is
     * proportional to is the box it is printed on and not the window.
     *
     * WHICH OF THE TWO TERMS ACTUALLY BINDS — measured, because an earlier revision of
     * this comment guessed and guessed wrong. It advertised a phone's one-column bib
     * and "a four-column wall on a desktop" printing at the same proportion; neither
     * half survives measurement.
     *
     *   at a 16px root   the 3rem cap binds at EVERY width from 320 to 3840, so the hero
     *                    is a constant 48px across the whole range. (It used to carve out
     *                    768, where the old 22cqi resolved to 47.96 against the 48px cap
     *                    and just undercut it. Widening the term to 30cqi closed that gap
     *                    rather than opening a new one: a larger percentage reaches the
     *                    cap sooner, so raising it can only ever bind at MORE widths.
     *                    Re-measured across ten widths after the change.)
     *   at a 42px root   the container term binds on a narrow bib, and the number
     *                    shrinks with its box instead of overflowing it. MEASURE THE
     *                    CONTENT BOX, NOT THE BIB: this line read "33px on the
     *                    150px-wide bib at 320px", which is 22% of 150 — but
     *                    `container-type: inline-size` resolves `cqi` against the
     *                    container's CONTENT box, 80.8px here, so the real figure was
     *                    17.78px. The number was out by 1.86x for as long as it stood,
     *                    and it is the number the whole rule was reasoned from
     *   columns          the wall reaches THREE, never four: `main` is `max-w-4xl`, so
     *                    the grid stops widening long before a fourth 13rem track fits
     *
     * So the container query is not what varies the hero across viewports; the cap does
     * that, and it does it by holding still. The cqi term earns its place under TEXT
     * ZOOM, where a rem-only size would keep growing while the bib does not. Both are
     * needed and each covers what the other cannot: the cap keeps 1022.00 — seven
     * characters, the widest the calendar holds — from filling a 13rem column at the
     * default size, and the cqi term keeps it inside a bib the reader's own text size
     * has squeezed to 150px.
     *
     * 30cqi, NOT 22 — BECAUSE THE HIERARCHY WAS INVERTING. Sized at 22cqi the hero
     * SHRANK as the reader asked for more text while `.bib-name` grew, and at 320px the
     * two crossed over: measured as the ratio of hero to name at that width,
     *
     *     root 16   4.36x        root 32   1.37x        root 40   0.74x
     *
     * — the distance printed 26% SMALLER than the race name beside it. A bib is a
     * printed number; that ratio is the object's identity, and inverting it says the
     * name is the headline. At 30cqi the same three configurations measure 4.36 / 1.87 /
     * 1.00, so the crossover is gone.
     *
     * THE OBVIOUS FIX IS THE WRONG ONE AND WAS BUILT BEFORE BEING REJECTED. A floor of
     * `max(1.25rem, ...)` looks like the direct answer and holds 1.82x at every root —
     * but `rem` grows with the very setting this is defending against, so at a 40px root
     * the floor IS 50px, and `1022.00` then measures 139.2px of ink inside a 54.5px box
     * and spills 14.2px past the bib's own edge. The clip sweep reported zero for it,
     * which is why this is written down: the loss is outside what that instrument reads,
     * and only a per-element ink-versus-box measurement finds it.
     *
     * 30cqi reaches PARITY at the extreme rather than dominance, which is a deliberate
     * stopping point rather than the best available number. Spill begins around 45px of
     * hero at 320px/root 40, so a larger term would buy more separation — at the cost of
     * a figure that is being sized by a rule nobody can check by reading it.
     */
    .bib-value {
        grid-area: value;
        margin: 0;
        font-size: min(3rem, 30cqi);
        font-weight: 800;
        line-height: 0.82;
        letter-spacing: -0.045em;
    }

    .bib-fraction {
        font-size: 0.4em;
        padding-inline-start: 0.08em;
    }

    /*
     * Set on its side, the way a bib prints its unit down the edge of the number.
     * `rotate(180deg)` puts the baseline on the correct side of a vertical-rl run.
     *
     * THE OPACITY IS 0.7 BECAUSE 0.55 FAILED, and the number is a floor rather than a
     * taste: this line arrived from the design rig at .55, where the ink composites
     * to 4.29:1 on a booked bib in the light theme and 4.11:1 on a finished one in
     * the dark. Both are under the 4.5:1 a 10px word needs, and neither can be found
     * by anything that reads the authored colour — the ink is `--background` on
     * `--text`, which is 18.86:1 before the opacity touches it.
     *
     * At 0.7 the same two land at 7.28:1 and 6.92:1, computed from the composite, and
     * 7.40 / 7.03 sampled from the rendered pixel. Quote the computed pair: the
     * sampler reads an extreme pixel of a 10px rotated glyph, so it is the noisier of
     * the two instruments here even though it is the authoritative one for the
     * question of WHETHER anything is compositing.
     *
     * The clearance is worth keeping: the composite runs against the FACE, and both
     * faces are near the extremes of the palette, so any future re-tone moves this
     * ratio. tests/patch-wall.test.ts composites every dimmed line on the bib and
     * holds all of them to the text floor, in every state and both themes — it takes
     * the states from `PatchState` rather than naming them, so a fourth joins the
     * sweep by existing.
     */
    .bib-unit {
        grid-area: unit;
        align-self: end;
        margin: 0;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-size: 0.625rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        opacity: 0.7;
    }

    /*
     * WHERE THE RACE IS, on its own line under the name rather than appended to it.
     *
     * The name row already wraps to two lines on the longest event the calendar holds, so
     * a middot and a country on the same line would make the wrap point depend on the
     * length of two unrelated strings. Its own row costs 15px flat on a page that
     * scrolls — /patches has no height clamp, unlike the home page — and it is one grid
     * area rather than a nested box.
     *
     * It is dimmed with the date and the tag rather than set at full ink: the place is
     * context for the race, not a second name for it. That puts it under the same
     * composited-contrast assertion as those two, which is where the 4.5:1 floor is
     * actually checked — the authored ink is 18.86:1 and tells you nothing.
     */
    .bib-place {
        grid-area: place;
        margin: 0;
        overflow-wrap: anywhere;
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.8;
    }

    /*
     * A BIB SAYS WHERE IT GOES IN WORDS, NOT WITH A HOVER. There is no hover on a phone, and
     * this site has already removed one card hover for advertising an affordance that did not
     * exist — the opposite failure is an affordance that exists and is never advertised. The
     * stub at the foot of the bib is permanent and is TEXT, so it carries the fact without
     * leaning on colour (SC 1.4.1).
     *
     * THE BIB ITSELF NOW HAS NO INTERACTIVE STATE AT ALL, and this rule is what is left of the
     * three that used to give it one. `.bib--linked:hover`, `:focus-visible` and `:active` all
     * painted an `--accent` outline around the whole box, which was correct while the box was
     * the anchor; every one of those states belongs to a stub line now (see `.bib-stub-link`,
     * which carries the same three in the bib's own ink and records why the token changes).
     * `text-decoration: none` survives because a stub link inherits it — a ruled link is a WEB
     * convention imported into a paper one, and a bib is a printed artifact.
     */
    .bib {
        text-decoration: none;
    }

    /*
     * THE TEAR LINE SITS AT THE FOOT OF THE BIB, NOT WHEREVER THE ROWS HAPPEN TO STOP.
     *
     * `.bib-cell` stretches a bib to the tallest bib in its grid row, and `.bib` packs its
     * rows to the top — so on a bib shorter than its row-mates the leftover height collected
     * BELOW the stub, and the perforation landed at whatever height that bib's own content
     * ended at. Measured on the wall at 1440x900: the tear line sat at three different
     * heights within a single row, up to 34.1px apart, and one bib printed 78.5px of empty
     * face beneath its own stub — a stub with a field under it is not a stub.
     *
     * The fix is one flexible row before `stub`, so the slack collects ABOVE the perforation
     * instead of below it. `deadBelow` — perforation to the bib's own bottom edge — is a
     * constant 11.4px on every bib in every row now, against a 11.4-78.5px spread before.
     *
     * ONE RULE CARRIES IT, WHERE IT USED TO TAKE FOUR. `.bib--linked` and `.bib--split` each
     * needed the extra rows, and `.bib--dnf` re-declared the template for its own hero, so a
     * DNF that also linked out needed a compound rule holding the union of both — grid areas
     * do not merge, and two single-class rules would simply have deleted each other's row. A
     * DNF now declares no template at all (see `.bib--dnf`) and every destination is a stub
     * line, so there is one modifier and one template left. Anything that reintroduces a
     * per-state template brings all four back.
     *
     * IT IS NOT DECLARED ON `.bib`, and that is a height decision rather than tidiness. A bib
     * with nowhere to go has no perforation for slack to sit under and nothing to hold down,
     * so the two extra rows would charge every bib on the wall — and `.bib-cell { display:
     * grid }` stretches a bib to its row's height, so the cost would propagate to its
     * row-mates as well.
     */
    .bib--stub {
        grid-template-areas: "date date" "value unit" "name name" "place place" "ledger ledger" ". ." "stub stub";
        grid-template-rows: repeat(5, auto) 1fr auto;
    }

    /*
     * THE STUB IS PERFORATED ONCE, NOT ONCE PER LINE, and that is the difference between
     * material vocabulary and decoration. A race bib has A stub — it does not sprout a second
     * one because a watch stopped, or because the organiser published a sheet — so the
     * perforation stays on the LIST and the lines are printed on it. A device that scales with
     * the length of an array has stopped describing the object and started describing the data.
     *
     * A RACE BIB IS PERFORATED ABOVE THE PART THAT CARRIES YOUR RESULT — the part you hand in,
     * or the part you keep. What sits below the line is where this race's result actually
     * lives, so the device is not decoration: it is the bib's own material vocabulary saying
     * the same thing the words say. If the lines ever stop leading somewhere, the perforation
     * goes with them.
     *
     * IT BORROWS THE PIN-HOLES' CONSTRUCTION BUT NOT THEIR GEOMETRY OR THEIR TOKEN, and both
     * departures were measured rather than reasoned. The obvious move is to draw a perforation
     * exactly like a corner pin-hole — same `radial-gradient`, same 1.7px-to-1.8px antialiasing
     * band, same `--hole` token, on the argument that a perforation and a pin-hole are the same
     * event on real paper. It was built that way first and rendered wrong twice over. At 1.7px
     * on a 6px tile the dots very nearly touch, so a RUN of them reads as a heavy dashed rule
     * rather than as holes — a pin-hole gets its character from being isolated. And `--hole` at
     * full strength is the card colour against an inverted face, the strongest mark this
     * palette can make; on a row meant to be a quiet piece of stationery it shouted. So: 1px
     * dots on the same 6px tile, in the row's own ink at 45%. `currentColor` rather than a
     * token means it follows the stub into forced colours without naming anything.
     *
     * IT IS A BACKGROUND AND NOT A PSEUDO-ELEMENT, and four separate gates in this repo are
     * why. It was built as `::before` first, and that version tripped every one of them at
     * once: the bib's colour resolver (patch-wall.test.ts) refuses any rule reaching a bib
     * through a combinator or pseudo, because it models the cascade as a class subset and would
     * otherwise read the rule as applying when it does not; the absolute-height gate, since a
     * 1px pseudo needs a pinned `height`; the every-class-has-a-rule gate; and this file's own
     * not-dimmed assertion, whose selector matched `::before` and read the perforation's alpha
     * as the ROW being dimmed. Painting it here needs no box, no height and no opacity — the
     * alpha lives in the colour via `color-mix`, which is how `.bib--booked` already tones its
     * border, and the dots sit on the list's own padding.
     */
    .bib-stub {
        grid-area: stub;
        display: grid;
        gap: 0;
        margin: 0.25rem 0 0;
        padding-top: 0.5rem;
        padding-inline: 0;
        padding-bottom: 0;
        list-style: none;
        background-image: radial-gradient(circle at 1.5px 0.5px,
            color-mix(in srgb, currentColor 45%, transparent) 0 1px, transparent 1.2px);
        background-size: 6px 1px;
        background-repeat: repeat-x;
        background-position: top left;
    }

    /*
     * ONE LINE OF THE STUB: ONE PLACE THIS BIB GOES. Where that is a part of a split race it
     * prints that part's own distance and clock, which are exactly the two figures a reader
     * would otherwise be ambushed by at the other end of the link.
     *
     * `min-height` IS THE TARGET FLOOR AND IT IS NOT DECORATIVE. This row is a target where
     * the whole bib used to be one. Without the declaration it renders 24.59px against
     * SC 2.5.8's 24px — a 0.6px pass resting on UnoCSS preflight's `line-height: 1.5`, which
     * nothing here declares or asserts; at 1.4 it fails. And two stub lines are vertically
     * adjacent with no gap, so the spacing exception is arithmetically identical to the size
     * rule (centre-to-centre distance IS the row height) and can never rescue one. 1.5rem is
     * the floor this repo already sets for a small control, and being font-relative it scales
     * with the reader's text instead of staying put.
     *
     * THE INLINE PADDING IS FOR THE FOCUS OUTLINE, and the negative margin undoes it for the
     * ink. An inset outline with no padding paints exactly on the leading edge of the
     * content — through the Strava mark — and on the trailing edge through the clock. The
     * padding gives the outline somewhere to land; the margin pulls the BOX back out so the
     * figures still line up with the name, the place and the elapsed row above them. The
     * perforation is on the list rather than this row, so it keeps the content width and
     * does not widen with the padding.
     *
     * `flex-wrap` and `overflow-wrap` for the reason `.bib-ledger` has them, and the same
     * trap: a bib does NOT clip, so ink that escapes paints onto the card at 1.045:1 —
     * unreadable rather than absent, and unseen by any sweep that walks only clipping
     * ancestors. `17.90`, `1:28:41` and `RESULT` are unbreakable tokens of the same shape as
     * the ledger's, which was measured escaping from a 42px root.
     */
    .bib-stub-link {
        display: flex;
        flex-wrap: wrap;
        overflow-wrap: anywhere;
        align-items: center;
        gap: 0.4em;
        margin-top: 0;
        margin-bottom: 0;
        margin-inline: -0.35rem;
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
        padding-inline: 0.35rem;
        min-height: 1.5rem;
        color: inherit;
        opacity: 0.8;
        text-decoration: none;
        font-size: 0.625rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .bib-stub-label {
        font-variant-numeric: tabular-nums;
    }

    /*
     * The clock is dimmed and the distance is not, which is the same split the ledger makes
     * within a row: the distance is what tells one link from another, the clock is context for
     * it. That puts this under the composited-contrast sweep with the date, the tag and the
     * place, where the floor is actually checkable — the authored ink is `--background` on
     * `--text`, 18.86:1, and tells you nothing.
     */
    .bib-stub-time {
        margin-left: auto;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.08em;
    }

    /*
     * THE STATE IS AN OUTLINE BECAUSE NOTHING ELSE IS ALLOWED TO BE ONE HERE, and it is drawn
     * in the bib's own ink rather than in `--accent`. Both halves are measured.
     *
     * The bib's own outline paints OUTSIDE the bib, so the surface it must clear is the card
     * — the pair `--accent` is already held to 3:1 against, at 6.52:1 light and 12.55:1 dark.
     * A stub line sits INSIDE the inverted face, where that same token lands at 2.77:1 and
     * 1.37:1, both under SC 1.4.11. (2.77 is the number the booked-bib note above already
     * flags for the sport mark: the palette has one accent and it was chosen against the
     * card.) `currentColor` is `--ink` on `--face`, 18.86:1 by construction, and it follows
     * the treatment per state and per theme instead of needing four pairs re-derived.
     *
     * The bib-native move — inverting the line the way the sport chips draw the current page
     * — is not available: patch-wall.test.ts refuses any selector carrying a pseudo-class on
     * a rule declaring colour, background colour, opacity or a custom property, so that would
     * be a red build on correct code. `outline` is not a modelled property, which is what
     * makes it the one channel a state has inside a bib.
     *
     * OFFSET INWARDS, because two stub lines are adjacent with no gap and an outset outline
     * would paint into the next target.
     *
     * The hover half is split from the others for the reason the retired whole-bib outline
     * split it: a touch
     * browser applies `:hover` on tap and holds it, while `:focus-visible` is a keyboard
     * indicator every device needs. `:active` is not gated either, and is the only affordance
     * a touch reader can produce deliberately — it matters more here than on the bib, because
     * the platform's own tap flash is `--accent` at 18% and composites to 1.09:1 on an
     * inverted face, which is nothing at all.
     */
    .bib-stub-link:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: -1px;
    }

    .bib-stub-link:active {
        outline: 2px solid currentColor;
        outline-offset: -1px;
    }

    @media (hover: hover) {
        .bib-stub-link:hover {
            outline: 2px solid currentColor;
            outline-offset: -1px;
        }
    }

    /*
     * THE LEDGER: EVERY ACCOUNT OF THIS RACE, ONE PER ROW, EACH CARRYING ITS OWN TWO FIGURES.
     *
     * IT REPLACES `.bib-time` AND `.bib-covered`, WHICH WERE ALREADY EACH OTHER'S TWIN. Those
     * two said the two things known about an abandoned race — how far and how long — in one
     * grammar, under one another. The device generalises exactly one step: a race can be known
     * TWICE, by the organiser and by the rider, and each knowing is a distance and a clock. So
     * the pair becomes a ledger and the twin rules become one.
     *
     * NOTHING A READER CAN DIVIDE CROSSES TWO ACCOUNTS, WHICH IS THE WHOLE RULE. Elapsed and
     * moving are far apart on a long ride — 8:32:05 against 5:03:55 on the 10 July ride — so a
     * bare time invites a reader to divide it into whatever distance is nearest and conclude a
     * speed the rider never held. The old answer was a LABEL naming which clock; this one is
     * stronger, because the two figures a reader would naturally divide are now on the same
     * line and belong to the same instrument by construction. A gun time is never printed
     * beside a GPS distance. See `official_row` in constants.ts for why the rows are named for
     * their SOURCE rather than for their clock, and what that costs.
     *
     * THREE COLUMNS ON THE LEDGER, NOT ON EACH ROW: a row is `display: contents`, so its three
     * spans are laid out by this grid and every cell in a column shares a track. Two rows
     * sized independently would not line up, and a ledger whose columns do not line up is a list.
     *
     * THE SOURCE NAMES AND THE HEADINGS ARE DIMMED; THE FIGURES ARE NOT. That puts the
     * captions under the same composited-contrast assertion as the date, the tag and the place
     * — the authored ink is `--background` on `--text`, 18.86:1 before any opacity touches it,
     * so the floor is only checkable from the composite.
     *
     * IT WRAPS, AND IT BREAKS. Two separate defects, and the first fix did not cover the
     * second — a review panel found that on the row this replaces, and the numbers here are
     * the corrected ones. Wrapping alone is necessary and not sufficient: each line is then
     * sized independently, and `OFFICIAL`, `21.10` and `3:30:59` are single unbreakable tokens,
     * so at a large enough text size each one is individually wider than the bib and paints
     * OUTSIDE it. Measured on the row this replaces, against the bib's BORDER box (the
     * meaningful edge — the 0.8rem of padding inside it is inverted face, where ink is
     * perfectly legible) at 320px: the caption escaped from a 40px root (+9.88px) and the
     * figure from 42px (+1.55px), reaching +75.5 and +47.11 at a 48px root. There the ink is
     * `--background` on the CARD rather than on the bib's face — 1.045:1, unreadable — so
     * "3:30:59" reads as "3:30:" and "OFFICIAL" as "OFFI".
     *
     * `overflow-wrap: anywhere` is what fixes it, and `anywhere` rather than `break-word` for
     * the reason recorded on the wall's page heading: `break-word` does not affect intrinsic
     * minimum sizing, so it breaks the rendered line and leaves the overflow. It is declared
     * on the ledger and inherits to every cell.
     *
     * TWO INSTRUMENTS MISSED THIS AND THE REASON IS THE SAME. The wall sweep walks only
     * elements inside a clipping ancestor, and `.bib` does not clip (`container-type` is not a
     * clip) — so the ink escapes onto the card and the sweep reports nothing. Before that it
     * excluded no visually-suppressed subtree either, and the sr-only text this bib introduced
     * buried the real loss under thousands of pixels of fake one. A page that does not clip
     * needs its own edge measured.
     */
    /*
     * THE SLACK GOES AFTER THE ROW'S NAME, NEVER BETWEEN ITS TWO FIGURES, and that is the one
     * thing this track list is for. Both were built and rendered.
     *
     * `auto 1fr auto` puts the flexible track in the MIDDLE, so a bib wider than its ledger's
     * content strands the clock at the right-hand edge: measured on a 390px viewport, where
     * the wall gives a bib the full 324px, the ink gap between `160.56` and `10:56:17` was
     * **127.4px** against 5.5px everywhere else. That is the rift a reader has to scan across
     * — and it falls exactly between the distance and the clock that belong to the SAME
     * source, which is the one pair this whole device exists to keep together.
     *
     * `1fr auto auto` moves the slack to the leader position, where a gap after a row's key is
     * what a results sheet, an index and a scorecard all already do. The two
     * figures group and right-align in shared tracks, so `21.10` sits over `22.45` and
     * `3:30:59` over `3:44:25` — the comparison the ledger is FOR is now a vertical one.
     *
     * `minmax(0, auto)` ON THE FIGURE TRACKS, NOT BARE `auto`, and it is not decoration. An
     * `auto` minimum is the content's MIN-CONTENT size, which an unbreakable token like
     * `10:09:34` cannot go below however the text is allowed to wrap — so the track holds the
     * grid wider than the bib and the ink paints on the card at 1.045:1, where it is
     * unreadable rather than absent and no clip sweep sees it (`.bib` does not clip). Measured
     * at 320px: the clock column escaped the border box by +3.52px from a 44px root and
     * +4.61px at 48; with the floor removed it is 39.39px INSIDE at the same setting.
     * `overflow-wrap: anywhere` below is what then breaks the token — the two are a pair, and
     * neither works alone.
     */
    .bib-ledger {
        grid-area: ledger;
        display: grid;
        grid-template-columns: 1fr minmax(0, auto) minmax(0, auto);
        align-items: baseline;
        overflow-wrap: anywhere;
        column-gap: 0.55em;
        row-gap: 0.2rem;
        margin: 0.15rem 0 0;
        padding: 0;
        font-size: 0.625rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    /* See the ledger's note: a row is not a box, it is three cells joining the ledger's own
       columns. Without this each row would be its own formatting context, and the columns
       would then be per-row rather than shared — which is the difference between a set of
       ruled figures and a list. */
    .bib-ledger-head,
    .bib-ledger-row {
        display: contents;
    }

    /*
     * FIVE CLASSES, THREE SELECTOR LISTS, AND THEY MUST STAY LISTS. Splitting one to "tidy up"
     * is how a heading and the column under it drift a weight or an alignment apart, which
     * nothing in the suite would catch and every reader would feel.
     *
     * THE CROSSING IS THE POINT: a cell is drawn by what KIND it is and placed by which COLUMN
     * it is in, and those two groupings are not the same partition. All three captions are
     * dimmed and 700 — a heading is a caption — while both headings are aligned with the
     * figures beneath them rather than with the caption beside them. Written as one class per
     * cell rather than as combinators because the colour model in patch-wall.test.ts refuses
     * any rule reaching a bib through one.
     */
    .bib-ledger-who,
    .bib-ledger-km-head,
    .bib-ledger-time-head {
        font-weight: 700;
    }

    .bib-ledger-km,
    .bib-ledger-time {
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.06em;
    }

    .bib-ledger-km,
    .bib-ledger-km-head,
    .bib-ledger-time,
    .bib-ledger-time-head {
        justify-self: end;
    }

    /*
     * THE CLOCK COLUMN BUYS ITS OWN AIR, AND IT IS PADDING RATHER THAN A WIDER `column-gap`.
     *
     * WHY IT IS NEEDED AT ALL: grouping the two figures closed a 127px rift and opened its
     * opposite in the same edit. `160.56` and `10:56:17` are both tabular, both 800, both 10px,
     * and at the ledger's 0.55em gap they read as ONE run of digits — reported on the rig the
     * moment it was drawn. A distance and a clock are different fields and the drawing has to
     * say so.
     *
     * WHY NOT A WIDER GAP: `column-gap` is uniform, so widening it pays TWICE — once here,
     * where it is wanted, and once between the row's name and its distance, where the flexible
     * track already provides all the separation anyone needs. Measured at the wall's narrowest
     * bib (218px, at a 768px viewport): a 1.5em uniform gap wraps 4 cells and 2.2em wraps 10,
     * because the extra demand squeezes the leader track to nothing and the row's name breaks.
     * The same air bought as padding on ONE side wraps NOTHING at 1.4em — the leader track
     * absorbs it, which is exactly what a flexible track is for.
     *
     * 1.4em IS 19.5px OF INK-TO-INK SEPARATION against 5.5px before, roughly three characters
     * at this size. Re-measure rather than re-reason if it moves: the binding constraint is the
     * narrowest bib on the wall, not the phone, because a phone gives a bib the whole column.
     *
     * IT GOES ON THE HEADING TOO, or the heading stops sitting over the column it governs.
     */
    .bib-ledger-time,
    .bib-ledger-time-head {
        padding-left: 1.4em;
    }

    /*
     * WHEN THE BIB IS TOO NARROW FOR THREE COLUMNS, THE ROW'S NAME TAKES A LINE OF ITS OWN.
     *
     * WHAT GOES WRONG WITHOUT THIS, AND WHY NOTHING CAUGHT IT. `overflow-wrap: anywhere` above
     * lets a cell's min-content fall to ONE CHARACTER, which is what stops the clock painting
     * on the card — and it is also a licence for the leader track to be squeezed to nothing
     * long before anything overflows. Measured on the shipped wall at a 32px root, WCAG SC
     * 1.4.4's required 200%: a 390px phone gives the bib 260px, and `RECORDED` rendered as
     * eight stacked single letters beside a two-line `10:56:17`. The escape sweep that passed
     * this design read ink against the bib's edge and found none — correctly, because the text
     * was not escaping, it was SHATTERING. A containment measurement cannot see a legibility
     * failure, and this pair of properties converts the second into the first by design.
     *
     * THE CONDITION IS THE BIB'S OWN WIDTH IN `em`, NOT A VIEWPORT BREAKPOINT. A wall column is
     * `min(13rem, 100%)`, so the same bib width arrives from a phone at a large text size and
     * from a tablet showing more columns; measured, the two are indistinguishable to the
     * ledger and a viewport query would catch one and miss the other. `.bib` already declares
     * `container-type: inline-size`, and its font-size tracks the root exactly, so `em` here is
     * the reader's own text size — which is the whole point, since the failure is what happens
     * when they enlarge it. Swept 16→32px root across ten viewports: every band that wrapped
     * was at or under 13.08em and every clean band at or over 13.63em, so 14em sits in the gap
     * and takes the 13.63em band with it — that one is the 218px bib whose own margin is under
     * a pixel (see the clock-column note above, which had it as the binding case and was
     * measuring a floor 10px too high).
     *
     * THE FIGURES KEEP THEIR SHARED COLUMNS, which is the reason the name moves rather than
     * the ledger collapsing to one column per cell. `21.10` still sits over `22.45` and
     * `3:30:59` over `3:44:25`; a source's distance still sits beside that same source's
     * clock, so the rule that nothing divisible crosses two sources survives the reflow
     * untouched. Only the leader rail is spent, and it is the one thing here a reader can do
     * without: the name is already the first thing on its row.
     */
    @container (max-width: 14em) {
        .bib-ledger-who {
            grid-column: 1 / -1;
            justify-self: start;
        }

        /* The name now occupies a whole row, so auto-placement would put the distance back
           under it in the leader column. Both figures are pinned to the tracks their own
           headings are in. */
        .bib-ledger-km {
            grid-column: 2;
        }

        .bib-ledger-time {
            grid-column: 3;
        }
    }

    /*
     * NARROWER STILL, AND THE CLOCK TAKES THE LINE. Two figures stop fitting on one line well
     * before the reader stops enlarging, and what breaks then is the worse failure of the two:
     * a distance wraps into two readable halves, but `10:56:17` wrapping after `10:5` reads as
     * a DIFFERENT TIME, not as a damaged one. A figure that lies is worse than a figure that is
     * hard to read, so the clock gets a whole line before it is allowed to break.
     *
     * MEASURED, NOT CHOSEN. At a 390px viewport and a 32px root the ledger has 206.8px, while
     * `160.56` (79.2px), the gap (11px) and `10:56:17` (130.4px) want 220.6px between them even
     * with the clock's air given back — so no amount of tuning fits them on one line. At 320px
     * the ledger has 136.8px against a clock needing 130.4px, and one figure per line is the
     * only arrangement that exists. 9em is the widest band that still fails; every band above
     * it is clean under the rule above, so the two arms hand over without overlapping.
     *
     * THE CLOCK'S AIR IS RETURNED HERE because the thing it was bought to prevent cannot happen
     * on a line the distance is not on — see the clock-column note, which is about two figures
     * reading as one run of digits.
     *
     * THE UNIT HEADING STAYS AND THE CLOCK'S DOES NOT, which is not symmetry but a judgement
     * about what each figure can say for itself: `H:MM:SS` announces what it is to anyone who
     * reads it, and `78.59` does not. The ledger's whole reason for a heading row was to state
     * the unit ONCE rather than on every figure, so the unit is the one that has to survive.
     */
    @container (max-width: 9em) {
        .bib-ledger-time {
            grid-column: 1 / -1;
            padding-left: 0;
        }

        .bib-ledger-time-head {
            display: none;
        }
    }

    .bib-name {
        grid-area: name;
        margin: 0;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        line-height: 1.3;
        text-transform: uppercase;
        overflow-wrap: break-word;
    }

    /*
     * ==========================================================================================
     * MODE OVERRIDES. EVERYTHING BELOW THIS LINE MUST STAY BELOW EVERY PLAIN RULE ABOVE IT.
     * ==========================================================================================
     *
     * An at-rule adds NO specificity, so `@media {...}` and a plain rule are the same weight and
     * the later one wins. Two overrides in this file were once written up beside their same-mode
     * siblings and were dead from the moment they were written — forced colours kept painting an
     * `--accent` outline the mode discards, and print kept a hover outline on paper.
     *
     * THE NOTE THAT RECORDED THAT WAS ITSELF STALE, AND THE BUG BEHIND IT WAS THEN REPRODUCED.
     * It said these blocks sat "at the foot of the sheet"; they did not — four plain rules were
     * below them, which was harmless only because none of the four happened to touch a property
     * an override sets. Adding a row with a perforation broke that coincidence: the base rule
     * landed below the print at-rule, and the print override measured DEAD in the built
     * stylesheet — offset 3680 against a base rule at 3955. Caught by reading emitted rule
     * offsets out of `dist`, which is the only place source order is observable; nothing in the
     * suite and nothing in review saw it. (No class is named in this paragraph on purpose: the
     * ones involved have since been renamed, and a rule name in a story about ordering is the
     * part that goes stale while the lesson does not.)
     *
     * So the blocks were moved to where the comment always claimed they were. Anything
     * mode-specific belongs here, at the actual end, and any new plain rule belongs ABOVE.
     */
    /*
     * THE HOVER HALF OF EACH OVERRIDE BELOW CARRIES `and (hover: hover)`, matching the base
     * rule it overrides. Neither could misfire on a phone without it — one paints only in
     * forced colours and the other only on paper — but the gate in tests/build-output.test.ts
     * is a universal with no carve-outs, and a universal is worth more than two exemptions
     * that each need re-arguing. Note `(hover: hover)` is TRUE while printing from a pointer
     * device (measured, not assumed), so the print override is still live where it matters.
     */
    @media (forced-colors: active) {

        /*
         * The mark is an icon class, so its artwork is a MASK over
         * `background-color: currentColor` — and background-color is a forced property, so
         * without this the glyph paints Canvas on Canvas and vanishes. Measured on the previous
         * revision with the mode emulated: glyph rgb(255,255,255) on a bib face of
         * rgb(255,255,255), a ratio of exactly 1. Same fix as EventsLink.astro's chevron.
         *
         * IT MOVED HERE WITH THE GLYPH rather than being deleted alongside the row that used to
         * carry it. What it protects is smaller than it was — the row's WORDS survive forced
         * colours whatever happens to the glyph, so the label is no longer identified by a mark
         * that can disappear — but a brand mark that paints nothing is still a defect, and this
         * is one declaration.
         */
        .bib-stub-mark {
            forced-color-adjust: none;
            background-color: LinkText;
        }

        /*
         * `LinkText` on each line, so it is coloured as a link rather than as body text — and
         * in this mode that colour is doing real work, because a stub line carries no text
         * decoration (see the plain rules above for why a rule on a bib is the wrong
         * vocabulary). The words and the perforation both survive; this is what makes them
         * read as controls.
         */
        .bib-stub-link {
            color: LinkText;
        }

        /*
         * THE PERFORATION IS A BACKGROUND IMAGE, WHICH THIS MODE DISCARDS, so it is redrawn in
         * the one channel forced colours does not touch: border-style and border-width. Same
         * trade the two bib treatments make a few rules up — a distinction drawn differently is
         * worth more than a faithful one that cannot be drawn at all.
         *
         * The dots become dashes, which is the closest a border can come to a row of holes. It
         * is not the pin-holes' language any more, but nothing in this mode is: the corner holes
         * disappear here too, for exactly the same reason.
         */
        .bib-stub {
            background-image: none;
            border-top: 1px dashed CanvasText;
        }
    }

    @media (forced-colors: active) and (hover: hover) {
        .bib-stub-link:hover {
            outline-color: LinkText;
        }
    }

    @media (forced-colors: active) {
        .bib-stub-link:focus-visible {
            outline-color: LinkText;
        }
    }

    @media print {
        /*
         * Chrome's default `print-color-adjust: economy` drops backgrounds, so the perforation
         * goes the same way the pin-holes and the bib's face already do on paper. Redrawn as a
         * dashed rule in literal black, matching the decision the print at-rule above makes for
         * every other line on the bib: paper is white whichever theme the reader had on screen,
         * so a token here would carry an assumption that is only true half the time.
         *
         * It is worth keeping in print precisely BECAUSE the links are dead on paper: the
         * perforation is the part of the stub that still means something there — it says this
         * bib has one — while the lines become a note about where the race is recorded and who
         * recorded it. */
        .bib-stub {
            background-image: none;
            border-top: 1px dashed #000;
        }
    }

    @media print and (hover: hover) {
        .bib-stub-link:hover {
            outline: none;
        }
    }

    @media print {
        .bib-stub-link:focus-visible {
            outline: none;
        }
    }
</style>
