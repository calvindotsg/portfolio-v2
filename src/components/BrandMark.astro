---
/**
 * THE BRAND MARK AS THE SITE WEARS IT — one markup that re-tones with the theme.
 *
 * `ink` and `track` are the theme's own custom properties rather than values, so the mark
 * follows `:root[data-theme]` the way everything else on the page does and there is no
 * second variant to keep in step. The files under `/brand/` are the other half of that
 * split: those carry literal hexes because a consumer fetching an SVG has no stylesheet to
 * resolve a variable against. Same drawing, two delivery problems.
 *
 * SIZE COMES FROM `font-size` ON THE WRAPPER, which is how every mark on this site is
 * sized — the Iconify masks are `1em` boxes too. So a placement says how big the mark is
 * relative to the text beside it and never in pixels, and the reader enlarging their type
 * enlarges the mark with it.
 *
 * `vertical-align: -0.145em` IS BORROWED RATHER THAN CHOSEN. It is exactly what
 * `presetIcons` puts on every icon in `uno.config.ts`, so the brand mark sits on the same
 * baseline as the mark it replaced and nothing else on the line moved.
 *
 * NAMED OR CONCEALED, NEVER NEITHER. Pass `label` where the mark is the only thing carrying
 * a meaning — on the intro card it prints how full the bar is and says what it is full OF,
 * which is the one placement where the figure has a reader. Leave it off where something
 * beside the mark already says the same thing, and the SVG announces nothing.
 */
import {markFill, markSvg} from "../lib/brand-mark"

type Props = {
    /** Any CSS length; sets the wrapper's `font-size`, and the mark is a 1em box in it. */
    size?: string
    /** The accessible name. Omitted, the mark announces nothing to assistive technology. */
    label?: string
}

const {size = "1em", label} = Astro.props

const svg = markSvg({
    ink: "var(--brand-ink)",
    track: "var(--progress-track)",
    fill: markFill(),
    title: label,
})
---

<span class="brand-mark" style={`font-size:${size}`} set:html={svg}/>

<style>
    /*
     * The wrapper is the box; the SVG fills it. Splitting them this way is what lets a
     * placement set one number — `font-size` — and get a square mark on the text baseline,
     * rather than setting a width, a height and an offset that have to agree.
     */
    .brand-mark {
        display: inline-flex;
        width: 1em;
        height: 1em;
        vertical-align: -0.145em;
    }

    /*
     * `inline-flex` RATHER THAN `inline-block`, AND THE REASON IS THE ORPHAN GATE. Either
     * would draw this correctly, but an inline-block wrapper needs the SVG made blockish to
     * kill the baseline gap under it — and UnoCSS extracts the text of a `<style>` element,
     * so that one declaration emits a utility rule no element on this site wears and
     * `tests/build-output.test.ts` fails the DEPLOY. A flex item needs no such declaration.
     * The alternative was adding the word to `blocklist` in `uno.config.ts` engine-wide to
     * buy one property here, which is a decision about every page rather than about this one.
     */
    .brand-mark :global(svg) {
        width: 100%;
        height: 100%;
    }
</style>
