---
import Card from "./Card/index.astro";
import type {Goal} from "../lib/constants";
import ProgressBar from './ProgressBar.astro';

interface Props {
    goal: Goal;
}

// This card reports a figure and offers no way out to the service the figure came
// from. It used to carry a styled control beside its numbers, as did the other goal
// card, and both went to the same Strava profile the intro card's social link
// already reaches — three of the page's nine controls spent on one destination that
// a logged-out visitor meets a login wall at. See the note on the Strava URL in
// constants.ts before adding a per-goal link back; there is no per-sport URL to
// point one at.
//
// The figures row therefore holds a single child now, so the utility that used to
// distribute it against the control went with the control: with one child it can only
// ever resolve to the start edge, and a token that cannot change anything reads as a
// constraint that does. That is a statement about THAT token, not a principle applied
// to the file — other inert layout tokens remain here deliberately, because they are
// load-bearing the moment a second child returns and this change did not touch the
// lines they sit on.

const {goal} = Astro.props;
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-3" title=`My ${goal.goal_name} goal this year`>
    <div class="flex justify-between w-full items-start mb-2">
        <div class="flex flex-col w-full px-3">
            <ProgressBar
                         currentProgress={goal.current_progress}
                         totalGoal={goal.total_goal}
                         goalLogo={goal.goal_logo}
                         label=`${goal.goal_name} progress`
                         unit={goal.measurable_unit}
            />
            <div class="mt-4 flex items-center text-xs font-light">
                <div class="flex flex-col space-y-1">
                    <span>{goal.current_progress} {goal.measurable_unit} of {goal.total_goal} {goal.measurable_unit}</span>
                    <span>Last year's: {goal.progress_last_year !== null
                        ? `${goal.progress_last_year} ${goal.measurable_unit}`
                        : <><span aria-hidden="true">–</span><span class="sr-only">first year back</span></>}</span>
                </div>
            </div>
        </div>
    </div>
</Card>
