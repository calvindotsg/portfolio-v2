# Umami analytics. PUBLIC — this id is served in the HTML of every page, so it is a
# GitHub repository VARIABLE (`vars.UMAMI_ID`), never a secret. Marking it secret would
# mask it in build logs and buy nothing, and a secret cannot be read back to check it.
#
# It FAILS OPEN, which is why CI asserts on it: `data-website-id={import.meta.env.UMAMI_ID}`
# drops the whole attribute when the value is unset, and the <script> still loads. The page
# looks correct, returns 200, and records nothing. Locally that is fine — leave the
# placeholder — but `ci.yml` greps every built page for the real id so a dropped attribute
# cannot reach production silently.
UMAMI_ID = "example_umami_id"
